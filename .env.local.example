# Copy this file to .env.local and fill in your token.
# .env.local is gitignored — never committed.
#
# Paste your API auth token here to skip Discord login in local dev.
# Find it in localStorage under the key "unreleased:authToken" after logging in once.
VITE_AUTH_TOKEN=your_token_here

# Last.fm scrobbling. Register an API account at
# https://www.last.fm/api/account/create and paste the key + shared secret —
# they're baked into the renderer bundle at build time; without them the
# Last.fm row in Settings shows as unavailable.
VITE_LASTFM_API_KEY=your_lastfm_api_key_here
VITE_LASTFM_API_SECRET=your_lastfm_shared_secret_here

# GitHub token used by scripts/python/release_android.py to publish releases.
GH_TOKEN=your_github_token_here
