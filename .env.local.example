# Copy this file to .env.local and fill in your token.
# .env.local is gitignored — never committed.
#
# Paste your API auth token here to skip Discord login in local dev.
# Find it in localStorage under the key "unreleased:authToken" after logging in once.
VITE_AUTH_TOKEN=your_token_here

# GitHub token used by scripts/release.py to publish releases.
GH_TOKEN=your_github_token_here

# Beta-channel admin secret — used only by scripts/release.py to publish beta
# builds to the gated backend (see /beta/admin/publish in scripts/release.py
# and build/fetch-releases.ps1).
BETA_ADMIN_TOKEN=your_beta_admin_token_here
