<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <!-- Downloaded update APKs (ApkInstallerPlugin). The package installer is
         a different process, so it can only read the file through a content://
         URI that FileProvider grants it — a file:// path throws
         FileUriExposedException on API 24+. Scoped to the one subdirectory the
         plugin writes to rather than all of external-files. -->
    <external-files-path name="updates" path="updates/" />
</paths>
