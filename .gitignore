# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-electron/
out/
release/
# build/ holds both generated output (bundled/) and real source (the NSIS
# installer script + the PowerShell helpers it File-includes) — CI checks out
# a fresh clone with no local build history, so the source files must
# actually be committed or electron-builder can't find them (build/installer.nsh
# missing broke build-windows.yml on 2026-08-17).
build/*
!build/installer.nsh
!build/fetch-releases.ps1
!build/relaunch.ps1
beta-builds/
scripts/build-gui/

# Electron builder
*.AppImage
*.deb
*.dmg
*.exe
*.msi
*.snap
*.zip

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
release_log.txt
release_err.txt

# Python
__pycache__/
*.pyc

# Runtime data
*.pid
*.seed
*.pid.lock

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Testing
coverage/

# Misc
*.local
.vercel-token

.vercel

# Capacitor — this is the Electron desktop branch, the mobile Capacitor
# project lives on mobile-android-ux only. Ignored wholesale here (not just
# build/) after android/ leaked in via a shared ancestor and sat committed,
# unused, for months (see commit removing it).
android/
ios/
